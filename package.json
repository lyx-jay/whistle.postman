{
  "name": "whistle.postman",
  "version": "1.0.1",
  "description": "Postman-like HTTP request management plugin for Whistle",
  "main": "index.js",
  "scripts": {
    "build": "bash scripts/build.sh",
    "lint": "echo 'No linter configured'",
    "test": "echo 'No tests configured'",
    "prepublishOnly": "npm run build && echo 'Ready to publish'",
    "version": "npm run build && git add -A",
    "postversion": "git push && git push --tags"
  },
  "files": [
    "index.js",
    "lib/",
    "ui/",
    "README.md",
    "CHANGELOG.md"
  ],
  "keywords": [
    "whistle",
    "plugin",
    "http",
    "postman",
    "api",
    "debug",
    "curl",
    "mock"
  ],
  "author": "",
  "license": "MIT",
  "whistleConfig": {
    "name": "Postman",
    "tab": "/ui/index.html",
    "comTab": "/ui/index.html",
    "networkMenus": [
      {
        "name": "Edit in Postman",
        "action": "/ui/index.html"
      }
    ]
  },
  "dependencies": {},
  "engines": {
    "node": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nicknisi/whistle.postman.git"
  },
  "bugs": {
    "url": "https://github.com/nicknisi/whistle.postman/issues"
  },
  "homepage": "https://github.com/nicknisi/whistle.postman#readme"
}
